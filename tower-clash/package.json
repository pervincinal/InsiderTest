{
  "name": "tower-clash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "levels:check": "tsx scripts/levelsCheck.ts",
    "playtest": "tsx scripts/playtest.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run levels:check",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.47.2",
    "@types/node": "22.7.4",
    "eslint": "9.12.0",
    "typescript": "5.6.2",
    "typescript-eslint": "8.8.0",
    "tsx": "4.19.1",
    "vite": "5.4.8",
    "vitest": "2.1.2"
  }
}
