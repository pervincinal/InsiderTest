{
  "name": "tower-clash",
  "version": "0.3.0",
  "config": {
    "buildNumber": 3
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "levels:check": "tsx scripts/levelsCheck.ts",
    "version:sync": "node scripts/syncVersion.mjs",
    "version:check": "node scripts/syncVersion.mjs --check",
    "playtest": "tsx scripts/playtest.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run levels:check",
    "e2e": "npm run build && playwright test --project=chromium",
    "e2e:webview": "npm run build && playwright test --project=android-webview",
    "cap:sync": "npm run build && cap sync",
    "android:build": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "ios:open": "npm run cap:sync && cap open ios",
    "icons:render": "tsx scripts/renderIcons.ts",
    "icons:generate": "npm run icons:render && capacitor-assets generate --android --ios --iconBackgroundColor \"#0f172a\" --splashBackgroundColor \"#0f172a\""
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "1.47.2",
    "@types/node": "22.7.4",
    "eslint": "9.12.0",
    "tsx": "4.19.1",
    "typescript": "5.6.2",
    "typescript-eslint": "8.8.0",
    "vite": "5.4.8",
    "vitest": "2.1.2"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.1.0",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/screen-orientation": "8.0.1",
    "@capacitor/status-bar": "8.0.3",
    "@revenuecat/purchases-capacitor": "13.5.1"
  }
}
